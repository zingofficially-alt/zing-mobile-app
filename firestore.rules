rules_version = '2';

// ZING Firestore security rules.
//
// Roles live in users/{uid}.role ("User", "Owner", "Admin"). Users cannot
// change their own role, storeAccess or hasPaid; only an Admin can. Store
// ownership is stores/{storeId}.owner.id.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? myUserDoc().data.get('role', '')
          : '';
    }

    function isAdmin() {
      return myRole() == 'Admin';
    }

    function isStoreOwner(storeId) {
      return signedIn()
          && exists(/databases/$(database)/documents/stores/$(storeId))
          && get(/databases/$(database)/documents/stores/$(storeId)).data.get('owner', {}).get('id', '') == request.auth.uid;
    }

    // The store id recorded on the caller's user document ('' if none).
    function myStoreId() {
      let store = myUserDoc().data.get('store', null);
      return store is map && store.get('id', null) is string ? store.id : '';
    }

    // True when the caller is the customer in a chat, or owns the store in it.
    // Chats are {participants: [customerUid, storeId]}.
    function isChatMember(chat) {
      return signedIn() && (
        request.auth.uid in chat.participants
        || (myStoreId() != ''
            && myStoreId() in chat.participants
            && isStoreOwner(myStoreId()))
      );
    }

    // Fields a user may never raise for themselves.
    function noPrivilegeEscalation() {
      let n = request.resource.data;
      let o = resource.data;
      return (n.get('role', null) == o.get('role', null)
              || (o.get('role', null) == null && n.get('role', null) == 'User'))
          && (n.get('storeAccess', null) == o.get('storeAccess', null)
              || n.get('storeAccess', null) != true)
          && (n.get('hasPaid', null) == o.get('hasPaid', null)
              || n.get('hasPaid', null) != true);
    }

    // ------------------------------------------------------------------ users

    match /users/{userId} {
      // Single documents can be read by signed-in users (chat partners, store
      // owners). Listing or querying the collection is admin-only.
      allow get: if signedIn();
      allow list: if isAdmin();

      // Self sign-up: may pick User or Owner, never Admin or paid access.
      allow create: if isSelf(userId)
          && request.resource.data.get('role', 'User') in ['User', 'Owner']
          && request.resource.data.get('storeAccess', false) != true
          && request.resource.data.get('hasPaid', false) != true;

      allow update: if isAdmin() || (isSelf(userId) && noPrivilegeEscalation());
      allow delete: if isSelf(userId) || isAdmin();

      // Subscription payments: written by admins only.
      match /payments/{paymentId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if isAdmin();
      }

      // The customer's own copy of their orders.
      match /orders/{orderId} {
        allow read: if isSelf(userId) || isAdmin();
        allow create: if isSelf(userId)
            && request.resource.data.userId == userId;
        allow update, delete: if isSelf(userId) || isAdmin();
      }

      match /cart/{itemId} {
        allow read, write: if isSelf(userId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isSelf(userId) || isAdmin();
        allow create: if isAdmin();
      }
    }

    // ----------------------------------------------------------------- stores

    match /stores/{storeId} {
      allow read: if true;

      allow create: if signedIn()
          && myRole() in ['Owner', 'Admin']
          && request.resource.data.owner.id == request.auth.uid;

      // Owners may edit their store but not hand it to someone else.
      allow update: if isAdmin()
          || (isStoreOwner(storeId)
              && request.resource.data.owner.id == resource.data.owner.id);

      allow delete: if isAdmin() || isStoreOwner(storeId);

      match /products/{productId} {
        allow read: if true;
        allow write: if isAdmin() || isStoreOwner(storeId);
      }

      match /ratings/{raterId} {
        allow read: if true;
        // One rating per user, stored under their uid.
        allow create, update: if isSelf(raterId)
            && request.resource.data.rating is number
            && request.resource.data.rating >= 0
            && request.resource.data.rating <= 5;
        allow delete: if isSelf(raterId) || isAdmin();
      }

      match /orders/{orderId} {
        allow read: if isAdmin()
            || isStoreOwner(storeId)
            || (signedIn() && resource.data.userId == request.auth.uid);

        // Customers place orders for themselves, always starting as Pending.
        allow create: if signedIn()
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.storeId == storeId
            && request.resource.data.get('status', 'Pending') == 'Pending';

        // The store owner/admin manages status; a customer may only cancel.
        allow update: if isAdmin()
            || isStoreOwner(storeId)
            || (signedIn()
                && resource.data.userId == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                && request.resource.data.status == 'Cancelled');

        allow delete: if isAdmin() || isStoreOwner(storeId);
      }
    }

    // ------------------------------------------------------------------ chats

    match /chats/{chatId} {
      allow read, update, delete: if isAdmin() || isChatMember(resource.data);

      // Customers open a chat with a store: participants = [uid, storeId].
      allow create: if signedIn()
          && request.resource.data.participants is list
          && request.resource.data.participants.size() == 2
          && (request.resource.data.participants[0] == request.auth.uid
              || isChatMember(request.resource.data));

      match /messages/{messageId} {
        allow read, write: if isAdmin()
            || isChatMember(get(/databases/$(database)/documents/chats/$(chatId)).data);
      }
    }

    // ------------------------------------------- admin-managed public content

    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /advertisements/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Everything else is closed by default.
  }
}
