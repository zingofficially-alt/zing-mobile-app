# ZING server (Railway). Copy to server/.env for local runs; on Railway set these
# under the service's Variables. Never commit the real values.

# Supabase project URL and the SERVICE-ROLE key (Project Settings > API).
# The service-role key bypasses Row Level Security: keep it on the server only,
# never in the Flutter app or in .env at the project root.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloud Translation API key for chat translation (POST /translate).
# Restrict it to the Cloud Translation API in Google Cloud. Without it the
# route answers 503 and chat shows the original text.
GOOGLE_TRANSLATE_API_KEY=

# Browser origins allowed to call the API, comma separated. Leave empty when
# only the phone app uses it (apps do not need CORS).
CORS_ORIGINS=

# Railway sets PORT itself.
# PORT=3000

# Only for `node scripts/db-apply.js` / `db-probe.js` (applying migrations).
SUPABASE_DB_HOST=
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_POOLER_HOST=
SUPABASE_PROJECT_REF=
