
platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Generate Flutter/Secrets.xcconfig (git-ignored) from the project-root .env so
# native iOS code can read keys via Info.plist. Re-run `pod install` after
# changing .env.
env_path = File.expand_path(File.join('..', '..', '.env'), __FILE__)
secrets_path = File.expand_path(File.join('..', 'Flutter', 'Secrets.xcconfig'), __FILE__)
secrets = ["// Generated from .env by ios/Podfile. Do not edit or commit."]
if File.exist?(env_path)
  File.readlines(env_path).each do |line|
    line = line.strip
    next if line.empty? || line.start_with?('#') || !line.include?('=')
    key, value = line.split('=', 2)
    value = value.strip.delete_prefix('"').delete_suffix('"')
    # xcconfig treats "//" as a comment; escape it so URLs survive.
    secrets << "#{key.strip} = #{value.gsub('//', '/$()/')}"
  end
else
  Pod::UI.warn 'ZING: .env not found - copy .env.example to .env and add your keys.'
end
File.write(secrets_path, secrets.join("\n") + "\n")

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # Add reCAPTCHA Enterprise for Firebase Phone Authentication
  pod 'RecaptchaEnterprise'

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Fix for Apple Silicon simulator architecture
    target.build_configurations.each do |config|
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386'
      config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'

      # Workaround for Swift stdlib issues in iOS 18+ simulators
      config.build_settings['DEAD_CODE_STRIPPING'] = 'YES'
      config.build_settings['LD_RUNPATH_SEARCH_PATHS'] ||= ['$(inherited)', '@executable_path/Frameworks']

      # Fix for WebKit framework linking issue with flutter_inappwebview
      config.build_settings['ENABLE_BITCODE'] = 'NO'

      # Fix for privacy bundle resource issues - disable validation
      config.build_settings['VALIDATE_PRIVACY_RESOURCE_BUNDLES'] = 'NO'
    end
  end

  # Fix for privacy manifest bundle issues
  installer.aggregate_targets.each do |target|
    target.xcconfigs.each do |variant, xcconfig|
      xcconfig_path = target.client_root + target.xcconfig_relative_path(variant)
      IO.write(xcconfig_path, IO.read(xcconfig_path).gsub("DT_TOOLCHAIN_DIR", "TOOLCHAIN_DIR"))
    end
  end

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      if config.base_configuration_reference.is_a? Xcodeproj::Project::Object::PBXFileReference
        xcconfig_path = config.base_configuration_reference.real_path
        IO.write(xcconfig_path, IO.read(xcconfig_path).gsub("DT_TOOLCHAIN_DIR", "TOOLCHAIN_DIR"))
      end
    end
  end

end
