rules_version = '2';

// ZING Cloud Storage security rules.
// Roles are read from Firestore users/{uid}.role.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '');
    }

    function isAdmin() {
      return signedIn() && role() == 'Admin';
    }

    function isOwnerOrAdmin() {
      return signedIn() && role() in ['Owner', 'Admin'];
    }

    // Uploads must be images under 10 MB. Deletes have no request.resource.
    function validImage() {
      return request.resource == null
          || (request.resource.size < 10 * 1024 * 1024
              && request.resource.contentType.matches('image/.*'));
    }

    // Admin-managed promotional content.
    match /offers/{file} {
      allow read: if true;
      allow write: if isAdmin() && validImage();
    }

    match /advertisements/{file} {
      allow read: if true;
      allow write: if isAdmin() && validImage();
    }

    // Store and product images, uploaded by store owners.
    match /store_images/{file} {
      allow read: if true;
      allow write: if isOwnerOrAdmin() && validImage();
    }

    match /products/{file} {
      allow read: if true;
      allow write: if isOwnerOrAdmin() && validImage();
    }

    // Profile pictures: each user writes only their own folder.
    match /user_images/{userId}/{file=**} {
      allow read: if true;
      allow write: if signedIn() && (request.auth.uid == userId || isAdmin()) && validImage();
    }

    // Chat images: the customer or the store owner of that chat.
    match /chat_images/{chatId}/{file=**} {
      function chat() {
        return firestore.get(/databases/(default)/documents/chats/$(chatId)).data;
      }
      function myStoreId() {
        let store = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('store', null);
        return store is map && store.get('id', null) is string ? store.id : '';
      }
      function isMember() {
        return signedIn() && (
          request.auth.uid in chat().participants
          || (myStoreId() != '' && myStoreId() in chat().participants
              && firestore.get(/databases/(default)/documents/stores/$(myStoreId())).data.owner.id == request.auth.uid)
        );
      }
      allow read: if isMember() || isAdmin();
      allow write: if (isMember() || isAdmin()) && validImage();
    }

    // Everything else is closed.
  }
}
