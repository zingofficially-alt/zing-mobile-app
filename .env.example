# ZING secrets. Copy this file to .env and fill in the values.
# .env is git-ignored: never commit it.
#
# Used by: Flutter (--dart-define-from-file=.env), Android (build.gradle)
# and iOS (generated ios/Flutter/Secrets.xcconfig on `pod install`).
# Keep values unquoted and on one line.

# Google Maps SDK key (Android + iOS). Restrict it to the app IDs in Google Cloud.
GOOGLE_MAPS_API_KEY=

# Google Directions API key (StoreScreen route drawing).
GOOGLE_DIRECTIONS_API_KEY=


# Supabase (publishable key only; the service_role key lives in server/.env)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Node API base URL (Railway)
API_BASE_URL=
